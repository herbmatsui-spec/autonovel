# ==============================================================================
# AutoNovel 環境設定テンプレート (.env.example)
# コピーして `.env` を作成し、必要な値を設定してください。
# ==============================================================================

# ---- サーバー基本設定 ----
APP_NAME=AutoNovel
APP_ENV=development
PORT=8200
HOST=0.0.0.0

# ---- データベース設定 (開発: SQLite, 本番: PostgreSQL) ----
DATABASE_URL=sqlite:///storage/autonovel.db

# ---- Huey / Redis タスクキュー ----
HUEY_BACKEND=sqlite
REDIS_URL=redis://localhost:6379/0

# ---- 認証・セキュリティ ----
# JWT 秘密鍵: 本番環境では必須かつ 32 文字以上である必要があります。
# 生成例: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=autonovel-dev-secret-key-minimum-32-bytes-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
# 開発用認証バイパス (True にすると認証なしでモック管理者を返却。本番環境では False 必須)
AUTH_DISABLED=False

# ---- LLM プロバイダー設定 ----
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ---- ベクターストア (RAG) ----
AUTONOVEL_RAG_MODE=auto
CHROMA_DB_PATH=chroma_db

# ---- 決済 (Stripe) ----
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
MULTIMEDIA_OUTPUT_DIR=E:\hhh\storage\multimedia
OLLAMA_BASE_URL=http://localhost:11434
PROSE_REFINER_MODEL=gemini-2.0-flash
VOICEVOX_TIMEOUT_SECONDS=30.0
REQUIRE_PG=False
REQUIRE_CHROMA=False
MULTI_LAYER_AUDIT_ENABLED=True
PROSE_REFINER_STYLE=balanced
VLLM_BASE_URL=http://localhost:8000
VOICEVOX_URL=http://localhost:50021
LOG_FORMAT=console
EMBEDDING_MODEL=text-embedding-3-small
LOG_LEVEL=INFO
IMAGE_PROVIDER=mock
HUEY_SQLITE_PATH=E:\hhh\storage\huey.db
RAG_REFLECTION_ENABLED=True
RERANKER_BACKEND=none
ENABLE_GRAPHRAG=True
OPENROUTER_MODEL=google/gemini-2.0-flash
OLLAMA_MODEL=llama3.1
COMFYUI_URL=
OPENROUTER_API_KEY=
EMBEDDING_MODEL_FALLBACK=text-embedding-3-small
PROSE_REFINER_ENABLED=True
ENABLE_AUDIO_SYNTH=False
OPENAI_BASE_URL=
VOICEVOX_DEFAULT_SPEAKER_ID=3
DALL_E_API_KEY=
APP_VERSION=4.9.0
RAG_FALLBACK_MODE=memory
CORS_ALLOW_HEADERS=Content-Type,Authorization,X-API-Key,Accept,Origin,X-Requested-With
ENRICHMENT_ENABLED=False
OPENROUTER_ROUTING={'planning': 'google/gemini-2.0-flash', 'plot_expansion': 'google/gemini-2.0-flash', 'writing': 'anthropic/claude-3-5-sonnet-20241022', 'climax': 'anthropic/claude-3-5-sonnet-20241022', 'audit': 'google/gemini-2.0-flash', 'marketing': 'google/gemini-2.0-flash'}
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
CHROMA_HOST=
ENABLE_MULTIMEDIA=False
SD_WEBUI_URL=
VLLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173,http://127.0.0.1:8080
ALLOWED_API_KEYS=
CHROMA_PORT=8000
BLIND_REVIEW_ENABLED=True
RAG_BATCH_SIZE=64
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AGE_GRAPH_NAME=autonovel_graph
