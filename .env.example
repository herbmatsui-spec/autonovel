# --- Database / Queue (Phase 0-4) ---
# 本番デプロイ時は強固なパスワードに変更してください
POSTGRES_PASSWORD=autonovel_change_in_production
REDIS_PASSWORD=redis_change_in_production
DATABASE_URL=postgresql://autonovel:autonovel_change_in_production@db:5432/autonovel
REDIS_URL=redis://:redis_change_in_production@redis:6379/0
HUEY_BACKEND=redis

# --- Security & CORS ---
# 許可オリジン (カンマ区切り)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173,http://127.0.0.1:8080

# --- Logging & Observability (Phase 5: Step 51-58) ---
# ルートロガーのレベル (既定: INFO)
LOG_LEVEL=INFO
# ログフォーマット: json (既定) または text
LOG_FORMAT=json
# デプロイ環境識別子 (local/staging/production 等)。全ログレコードの env フィールドに付与
APP_ENV=local
# 特定ロガーのレベル上書き (例: LOG_LEVEL_HUEY=DEBUG)。未設定可
# LOG_LEVEL_HUEY=DEBUG

# --- LLM & GraphRAG (Phase 6: pgvector + Apache AGE) ---
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
ENABLE_GRAPHRAG=true
AGE_GRAPH_NAME=autonovel_graph

# --- Vector / RAG (Phase: ハード依存化 Opt-in) ---
# pgvector が見つからないときに起動失敗させるか (デフォルト: false)
REQUIRE_PG=false
# chromadb が見つからないときに起動失敗させるか (デフォルト: false)
REQUIRE_CHROMA=false
# 必須依存不在時のフォールバック (memory: メモリ実装で続行 / error: 例外)
RAG_FALLBACK_MODE=memory
# 埋め込みバッチサイズ (OpenAI API 1 リクエストあたりのテキスト数)
RAG_BATCH_SIZE=64
# Reranker バックエンド (none / simple / cross_encoder)
RERANKER_BACKEND=none
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# ChromaDB の保存パス (スタンドアロン時)
CHROMA_DB_PATH=storage/chroma_db
CHROMA_HOST=
CHROMA_PORT=8000
# RAG バックエンド選択 (auto / chroma / memory)
AUTONOVEL_RAG_MODE=auto

# --- Multimedia (Phase 7: Asset Pack / Media Mix / IF Routes / eBook) ---
# マルチメディア機能を有効化 (デフォルト: false)
ENABLE_MULTIMEDIA=false
# 音声合成パイプラインを有効化 (デフォルト: false)
ENABLE_AUDIO_SYNTH=false
# マルチメディア成果物の出力先
MULTIMEDIA_OUTPUT_DIR=storage/multimedia
