# ============================================================
# AutoNovel v5.1.0 環境変数設定例 (Step 9)
# このファイルを .env にコピーして使用してください
# ------------------------------------------------------------
# 必須: [必須] 区画のみ設定すれば起動可能
# オプション: [オプション] 区画は未設定でもコア機能は動作
# ============================================================

# ------------------------------------------------------------
# [必須] データベース
# ------------------------------------------------------------
# ローカル起動 (SQLite):
DATABASE_URL=sqlite:///storage/autonovel.db
# Docker 起動 (PostgreSQL):
# DATABASE_URL=postgresql://autonovel:autonovel@postgres:5432/autonovel

# ------------------------------------------------------------
# [必須] アプリケーション基本設定
# ------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# ------------------------------------------------------------
# [オプション] Redis (未設定時はインメモリフォールバック)
# ------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------
# [オプション] LLM (未設定時は固定フォールバック応答)
# ------------------------------------------------------------
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here
LLM_MODEL=gpt-4o-mini

# ------------------------------------------------------------
# [オプション] RAG / 認証
# ------------------------------------------------------------
AUTONOVEL_RAG_MODE=memory
RAG_FALLBACK_MODE=memory
AUTH_DISABLED=true

# ------------------------------------------------------------
# [オプション] 機能フラグ (プラグイン疎結合化・Step 15-22)
# ------------------------------------------------------------
# マルチメディアプラグイン (画像・音声)。未設定 / false でコアから分離。
ENABLE_MULTIMEDIA=false
# 外部投稿プラグイン。未設定 / false でコアから分離。
ENABLE_SOCIAL_POSTING=false

# ------------------------------------------------------------
# [オプション] Docker Compose (dev) Database Credentials
# ------------------------------------------------------------
POSTGRES_USER=autonovel
POSTGRES_PASSWORD=autonovel_dev_password_change_me
POSTGRES_DB=autonovel

