# AutoNovel Configuration Template
# Copy to `.env` and fill in required values.

# ---- LLM provider selection ----
# One of: openai | gemini | mock | claude | ollama | vllm
LLM_PROVIDER=openai

# ---- OpenAI (or compatible) ----
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# ---- Google Gemini ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Anthropic Claude ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ---- Ollama / vLLM (local model servers) ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
VLLM_BASE_URL=http://localhost:8000
VLLM_MODEL=meta-llama/Llama-3.1-8B-Instruct

# ---- Production secrets (docker-compose.prod.yml) ----
POSTGRES_PASSWORD=
REDIS_PASSWORD=
UVICORN_WORKERS=1

# ---- AutoNovel Publisher Credentials ----

# NAROU
NAROU_EMAIL=
NAROU_PASSWORD=

# KAKUYOMU
KAKUYOMU_API_TOKEN=
KAKUYOMU_USER_ID=

# KOBO
KOBO_CLIENT_ID=
KOBO_CLIENT_SECRET=
KOBO_ACCESS_TOKEN=
KOBO_REFRESH_TOKEN=
KOBO_PUBLISHER_ID=

# KINDLE
KINDLE_CLIENT_ID=
KINDLE_CLIENT_SECRET=
KINDLE_REFRESH_TOKEN=
KINDLE_MARKETPLACE_ID=
