# Google Cloud設定
GOOGLE_CLOUD_PROJECT_ID=your-project-id-here
GOOGLE_APPLICATION_CREDENTIALS=path/to/your/service-account-key.json

# USB監視設定
USB_MONITOR_PATHS=E:\,F:\

# 出力ディレクトリ設定
OUTPUT_DIRECTORY=./output
TEMP_DIRECTORY=./temp

# ログ設定
LOG_LEVEL=INFO

# ファイルサイズ制限
MAX_FILE_SIZE_MB=50

# PDF処理設定
PDF_DPI=300

# Google Drive 設定
GOOGLE_DRIVE_FOLDER_ID=1aRixe-ctiwMHpepFrZ3DdDw5vhRxx4rE
