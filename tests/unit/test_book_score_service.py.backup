# NEW TESTS: Individual score calculation methods
@pytest.mark.asyncio
async def test_score_structure_method(calculator, mock_repo):
    """_score_structure メソッドのテスト"""
    # Mock the helper methods
    mock_repo.session = MagicMock()
    
    # Test case 1: All checks pass -> high score
    with patch.object(calculator, '_fetch_audit_report', return_value=[
        MagicMock(category='logical_consistency', severity='low'),
        MagicMock(category='causal_integrity', severity='low')
    ]), \
    patch.object(calculator, '_fetch_plot', return_value=MagicMock(end_ep=10)), \
    patch.object(calculator, '_fetch_chapter', return_value=MagicMock(tension=60)):
        
        score = await calculator._score_structure(book_id=1, chapter_number=1, ctx=None)
        # Should be high: causal_score=95, arc_score=95, pacing_score=90
        # Weighted: 95*0.35 + 95*0.35 + 90*0.30 = 33.25 + 33.25 + 27 = 93.5
        assert score == 93.5
    
    # Test case 2: Some checks fail -> medium score
    # Test case 2: Some checks fail -> medium score
    with (
    patch.object(calculator, "_fetch_audit_report", return_value=[
        MagicMock(category="logical_consistency", severity="high"),  # Fail
        MagicMock(category="causal_integrity", severity="low")      # Pass
    ]),
    patch.object(calculator, "_fetch_plot", return_value=MagicMock(end_ep=5)),  # Not close
    patch.object(calculator, "_fetch_chapter", return_value=MagicMock(tension=30)),  # Low tension
    ):

    score = await calculator._score_structure(book_id=1, chapter_number=1, ctx=None)
    # Should be medium: causal_score=75, arc_score=60, pacing_score=75
    # Weighted: 75*0.35 + 60*0.35 + 75*0.30 = 26.25 + 21 + 22.5 = 69.75
    assert score == 69.75
    patch.object(calculator, "_fetch_chapter", return_value=MagicMock(tension=30)):  # Low tension
        
    score = await calculator._score_structure(book_id=1, chapter_number=1, ctx=None)
    # Should be medium: causal_score=75, arc_score=60, pacing_score=75
    # Weighted: 75*0.35 + 60*0.35 + 75*0.30 = 26.25 + 21 + 22.5 = 69.75
    assert score == 69.75
    # Test case 3: Repository missing -> default score
    calc_no_repo = BookScoreCalculator(config_path="dummy.yaml", repository=None)
    with patch("src.services.book_score_service.open", create=True) as mock_open:
        import yaml
        config = yaml.dump({"default": {"structure": 25, "coherency": 25, "factual_grounding": 20, "visual_textual_synergy": 15, "reader_experience": 15}})
        mock_open.return_value.__enter__.return_value.read.return_value = config
        
        score = await calc_no_repo._score_structure(book_id=1, chapter_number=1, ctx=None)
        assert score == 50.0  # Default value


@pytest.mark.asyncio
async def test_score_coherency_method(calculator, mock_repo):
    """_score_coherency メソッドのテスト"""
    # Mock the helper methods
    mock_repo.session = MagicMock()
    
    # Test case 1: All checks pass -> high score
    with patch.object(calculator, '_fetch_audit_report', return_value[]), \
    patch.object(calculator, '_fetch_chapter', return_value=MagicMock(content="テストテストテスト")):
        
        score = await calculator._score_coherency(book_id=1, chapter_number=1, ctx=None)
        # Should be high: all checks pass -> 95 each
        # Weighted: 95*0.30 + 95*0.30 + 95*0.20 + 95*0.20 = 95.0
        assert score == 95.0
    
    # Test case 2: Some issues -> medium score
    with patch.object(calculator, '_fetch_audit_report', return_value=[
        MagicMock(category='speech_pattern', severity='high'),
        MagicMock(category='ability_check', severity='low'),
        MagicMock(category='temporal_consistency', severity='high')
    ]), \
    patch.object(calculator, '_fetch_chapter', return_value=MagicMock(content="テスト")):
        
        score = await calculator._score_coherency(book_id=1, chapter_number=1, ctx=None)
        # Should be medium: speech=50, ability=95, temporal=50, naming=95 (assuming good text)
        # Weighted: 50*0.30 + 95*0.30 + 50*0.20 + 95*0.20 = 15 + 28.5 + 10 + 19 = 72.5
        assert score == 72.5
    
    # Test case 3: Repository missing -> default score
    calc_no_repo = BookScoreCalculator(config_path="dummy.yaml", repository=None)
    with patch("src.services.book_score_service.open", create=True) as mock_open:
        import yaml
        config = yaml.dump({"default": {"structure": 25, "coherency": 25, "factual_grounding": 20, "visual_textual_synergy": 15, "reader_experience": 15}})
        mock_open.return_value.__enter__.return_value.read.return_value = config
        
        score = await calc_no_repo._score_coherency(book_id=1, chapter_number=1, ctx=None)
        assert score == 50.0  # Default value


