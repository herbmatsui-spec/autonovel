@pytest.mark.asyncio
async def test_score_visual_textual_method(calculator, mock_repo):
    """_score_visual_textual メソッドのテスト"""
    # Mock the helper methods
    mock_repo.session = MagicMock()
    
    # Test case 1: All checks pass -> high score
    illustration = MagicMock()
    illustration.prompt = "テスト テスト テスト"
    chapter = MagicMock()
    chapter.content = "テスト テスト テスト"
    chapter.tension = 50
    
    with patch.object(calculator, '_fetch_illustration', return_value=illustration), \
    patch.object(calculator, '_fetch_chapter', return_value=chapter):
        
        score = await calculator._score_visual_textual(book_id=1, chapter_number=1, ctx=None)
        # Should be high: entity=95, focus=95, tone=95
        # Weighted: 95*0.40 + 95*0.35 + 95*0.25 = 95.0
        assert score == 95.0
    
    # Test case 2: Some issues -> medium score
    illustration2 = MagicMock()
    illustration2.prompt = "completely different prompt"
    chapter2 = MagicMock()
    chapter2.content = "unrelated chapter content"
    chapter2.tension = 15  # Low tension
    
    with patch.object(calculator, '_fetch_illustration', return_value=illustration2), \
    patch.object(calculator, '_fetch_chapter', return_value=chapter2):
        
        score = await calculator._score_visual_textual(book_id=1, chapter_number=1, ctx=None)
        # Should be medium: low entity match, low focus match, low tone match
        assert 0 <= score <= 100
        # Just verify it returns a reasonable value
    
    # Test case 3: Missing data -> default score
    with patch.object(calculator, '_fetch_illustration', return_value=None), \
    patch.object(calculator, '_fetch_chapter', return_value=None):
        
        score = await calculator._score_visual_textual(book_id=1, chapter_number=1, ctx=None)
        assert score == 50.0  # Default value when data missing
    
    # Test case 4: Repository missing -> default score
    calc_no_repo = BookScoreCalculator(config_path="dummy.yaml", repository=None)
    with patch("src.services.book_score_service.open", create=True) as mock_open:
        import yaml
        config = yaml.dump({"default": {"structure": 25, "coherency": 25, "factual_grounding": 20, "visual_textual_synergy": 15, "reader_experience": 15}})
        mock_open.return_value.__enter__.return_value.read.return_value = config
        
        score = await calc_no_repo._score_visual_textual(book_id=1, chapter_number=1, ctx=None)
        assert score == 50.0  # Default value


@pytest.mark.asyncio
async def test_score_reader_experience_method(calculator, mock_repo):
    """_score_reader_experience メソッドのテスト"""
    # Mock the helper methods
    mock_repo.session = MagicMock()
    
    # Test case 1: All checks pass -> high score
    chapter = MagicMock()
    chapter.content = "なぜこれが起こったのか？突然の出来事に驚きを隠せない。これは真実なのか？そしてこれからどうなるのか？"
    chapter.tension = 70
    
    with patch.object(calculator, '_fetch_chapter', return_value=chapter):
        
        score = await calculator._score_reader_experience(book_id=1, chapter_number=1, ctx=None)
        # Should be high: good hook, good cliffhanger, good emotion
        assert score >= 80  # Expect high score for good content
    
    # Test case 2: Poor content -> low score
    chapter2 = MagicMock()
    chapter2.content = "今日は天気が良い。散歩に行った。"
    chapter2.tension = 10  # Very low tension
    
    with patch.object(calculator, '_fetch_chapter', return_value=chapter2):
        
        score = await calculator._score_reader_experience(book_id=1, chapter_number=1, ctx=None)
        # Should be low: weak hook, weak cliffhanger, poor emotion
        assert score <= 50  # Expect low score for poor content
    
    # Test case 3: Missing data -> default score
    with patch.object(calculator, '_fetch_chapter', return_value=None):
        
        score = await calculator._score_reader_experience(book_id=1, chapter_number=1, ctx=None)
        assert score == 50.0  # Default value
    
    # Test case 4: Repository missing -> default score
    calc_no_repo = BookScoreCalculator(config_path="dummy.yaml", repository=None)
    with patch("src.services.book_score_service.open", create=True) as mock_open:
        import yaml
        config = yaml.dump({"default": {"structure": 25, "coherency": 25, "factual_grounding": 20, "visual_textual_synergy": 15, "reader_experience": 15}})
        mock_open.return_value.__enter__.return_value.read.return_value = config
        
        score = await calc_no_repo._score_reader_experience(book_id=1, chapter_number=1, ctx=None)
        assert score == 50.0  # Default value


# NEW TESTS: Helper methods
@pytest.mark.asyncio
async def test_fetch_plot_method(calculator, mock_repo):
    """_fetch_plot ヘルパーメソッドのテスト"""
    # Test when repository has session
    mock_repo.session = MagicMock()
    mock_result = MagicMock()
    mock_repo.session.execute.return_value.scalars().first.return_value = mock_result
    
    result = await calculator._fetch_plot(book_id=1, chapter_number=1)
    assert result == mock_result
    mock_repo.session.execute.assert_called_once()
    
    # Test when repository has no session
    calculator._repository.session = None
    result = await calculator._fetch_plot(book_id=1, chapter_number=1)
    assert result is None
    
    # Test when repository is None
    calc_no_repo = BookScoreCalculator(config_path="dummy.yaml", repository=None)
    result = await calc_no_repo._fetch_plot(book_id=1, chapter_number=1)
    assert result is None


