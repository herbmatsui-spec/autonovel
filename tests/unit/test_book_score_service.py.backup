# NEW TESTS: Text statistics helper
@pytest.mark.asyncio
async def test_build_text_stats_method(calculator):
    """_build_text_stats ヘルパーメソッドのテスト"""
    # Test empty string
    stats = await calculator._build_text_stats("")
    assert stats["char_count"] == 0
    assert stats["word_count"] == 0
    assert stats["sentence_count"] == 0
    assert stats["avg_sentence_length"] == 0.0
    
    # Test simple text
    text = "こんにちは。世界。"
    stats = await calculator._build_text_stats(text)
    assert stats["char_count"] == len(text)
    assert stats["word_count"] == len(text.split())
    assert stats["sentence_count"] == 2  # Split by 。.!?
    assert stats["avg_sentence_length"] == stats["char_count"] / stats["sentence_count"]
    
    # Test text with no sentence endings
    text2 = "こんにちは世界"
    stats2 = await calculator._build_text_stats(text2)
    assert stats2["sentence_count"] == 0
    assert stats2["avg_sentence_length"] == 0.0  # Avoid division by zero


# NEW TESTS: Trend analysis methods
@pytest.mark.asyncio
async def test_analyze_trend_method(calculator, mock_repo):
    """analyze_trend メソッドのテスト"""
    # Test case 1: Insufficient data
    mock_repo.get_all_for_book.return_value = []  # No data
    result = await calculator.analyze_trend(book_id=1)
    assert "error" in result
    assert "Insufficient data" in result["error"]
    
    # Test case 2: Only one data point
    mock_repo.get_all_for_book.return_value = [MagicMock(overall_score=50.0)]
    result = await calculator.analyze_trend(book_id=1)
    assert "error" in result
    assert "Insufficient data" in result["error"]
    
    # Test case 3: Two data points (still insufficient)
    mock_repo.get_all_for_book.return_value = [
        MagicMock(overall_score=50.0),
        MagicMock(overall_score=60.0)
    ]
    result = await calculator.analyze_trend(book_id=1)
    assert "error" in result
    assert "Insufficient data" in result["error"]
    
    # Test case 4: Sufficient data - improving trend
    mock_scores = [
        MagicMock(overall_score=50.0),
        MagicMock(overall_score=55.0),
        MagicMock(overall_score=60.0),
        MagicMock(overall_score=65.0),
        MagicMock(overall_score=70.0)
    ]
    mock_repo.get_all_for_book.return_value = mock_scores
    
    result = await calculator.analyze_trend(book_id=1)
    assert "error" not in result
    assert result["book_id"] == 1
    assert result["chapters_evaluated"] == 5
    assert result["slope"] > 0  # Improving trend
    assert result["trend_direction"] == "improving"
    assert len(result["moving_avg_3"]) == 3  # 5-2 = 3
    assert result["latest_score"] == 70.0
    assert result["avg_score"] == 60.0
    
    # Test case 5: Sufficient data - declining trend
    mock_scores2 = [
        MagicMock(overall_score=70.0),
        MagicMock(overall_score=65.0),
        MagicMock(overall_score=60.0),
        MagicMock(overall_score=55.0),
        MagicMock(overall_score=50.0)
    ]
    mock_repo.get_all_for_book.return_value = mock_scores2
    
    result2 = await calculator.analyze_trend(book_id=1)
    assert "error" not in result2
    assert result2["slope"] < 0  # Declining trend
    assert result2["trend_direction"] == "declining"


@pytest.mark.asyncio
async def test_generate_pdca_report_method(calculator, mock_repo):
    """generate_pdca_report メソッドのテスト"""
    # Test case 1: Insufficient data for trend analysis
    mock_repo.get_all_for_book.return_value = [MagicMock(overall_score=50.0)]
    result = await calculator.generate_pdca_report(book_id=1)
    assert "error" in result
    assert "Insufficient data" in result["error"]
    
    # Test case 2: Sufficient data
    mock_scores = [
        MagicMock(overall_score=70.0, structure_score=75.0, coherency_score=65.0, 
                 factual_grounding_score=70.0, visual_textual_synergy_score=60.0, 
                 reader_experience_score=80.0),
        MagicMock(overall_score=75.0, structure_score=80.0, coherency_score=70.0, 
                 factual_grounding_score=75.0, visual_textual_synergy_score=65.0, 
                 reader_experience_score=85.0),
        MagicMock(overall_score=80.0, structure_score=85.0, coherency_score=75.0, 
                 factual_grounding_score=80.0, visual_textual_synergy_score=70.0, 
                 reader_experience_score=90.0)
    ]
    mock_repo.get_all_for_book.return_value = mock_scores
    
    result = await calculator.generate_pdca_report(book_id=1)
    assert "error" not in result
    assert result["book_id"] == 1
    assert "plan" in result
    assert "do" in result
    assert "check" in result
    assert "act" in result
    
    # Check plan section
    assert result["plan"]["target_score"] == 80.0
    assert result["plan"]["current_average"] == 75.0  # Average of 70, 75, 80
    assert result["plan"]["gap"] == 5.0  # 80 - 75
    # Should identify reader_experience as priority (highest score, but let's check logic)
    
    # Check do section
    assert "recent_scores" in result["do"]
    assert "trend_direction" in result["do"]
    assert "slope" in result["do"]
    
    # Check check section
    assert result["check"]["target_achieved"] == False  # 75 < 80
    assert result["check"]["trend_improving"] == True  # Scores increasing
    
    # Check act section
    assert "recommended_actions" in result["act"]
    assert len(result["act"]["recommended_actions"]) > 0
    assert "next_chapter_prediction" in result["act"]


# NEW TESTS: Configuration loading edge cases
def test_config_loading_with_overrides():
    """設定ファイルのオーバーライド機能のテスト"""
    with patch("src.services.book_score_service.open", create=True) as mock_open:
        import yaml
        config = yaml.dump({
            "default": {
                "structure": 20,
                "coherency": 20,
                "factual_grounding": 20,
                "visual_textual_synergy": 20,
                "reader_experience": 20,
            },
            "genre_overrides": {
                "literary": {
                    "structure": 30,
                    "reader_experience": 30,
                },
                "action": {
                    "factual_grounding": 40,
                }
            },
            "phase_overrides": {
                "climax": {
                    "structure": 35,
                }
            }
        })
        mock_open.return_value.__enter__.return_value.read.return_value = config
        calc = BookScoreCalculator(config_path="dummy.yaml", repository=None)
        
        # Test default weights
        weights = calc._get_weights()
        assert weights["structure"] == 20
        assert weights["coherency"] == 20
        assert weights["factual_grounding"] == 20
        assert weights["visual_textual_synergy"] == 20
        assert weights["reader_experience"] == 20
        
        # Test genre override
        weights = calc._get_weights(genre="literary")
        assert weights["structure"] == 30  # Overridden
        assert weights["reader_experience"] == 30  # Overridden
        assert weights["factual_grounding"] == 20  # Default
        
        # Test phase override
        weights = calc._get_weights(phase="climax")
        assert weights["structure"] == 35  # Overridden
        assert weights["coherency"] == 20  # Default
        
        # Test both overrides
        weights = calc._get_weights(genre="action", phase="climax")
        assert weights["structure"] == 35  # Phase override
        assert weights["factual_grounding"] == 40  # Genre override
        assert weights["coherency"] == 20  # Default


# NEW TESTS: Error handling in score methods
@pytest.mark.asyncio
async def test_score_methods_exception_handling(calculator):
    """スコア計算メソッドの例外処理のテスト"""
    # Test that all score methods return 50.0 (default) when exceptions occur
    
    # Mock repository to raise exceptions
    mock_repo.session = MagicMock()
    mock_repo.session.execute.side_effect = Exception("Database error")
    
    # Test each score method
    score_structure = await calculator._score_structure(book_id=1, chapter_number=1, ctx=None)
    assert score_structure == 50.0
    
    score_coherency = await calculator._score_coherency(book_id=1, chapter_number=1, ctx=None)
    assert score_coherency == 50.0
    
    score_factual = await calculator._score_factual(book_id=1, chapter_number=1, ctx=None)
    assert score_factual == 50.0
    
    score_visual = await calculator._score_visual_textual(book_id=1, chapter_number=1, ctx=None)
    assert score_visual == 50.0
    
    score_reader = await calculator._score_reader_experience(book_id=1, chapter_number=1, ctx=None)
    assert score_reader == 50.0