itorIsFollowing":false},"Episode:2912051605905827345":{"__typename":"Episode","id":"2912051605905827345","title":"第1話　【旅立ち・１】","publishedAt":"2026-08-10T03:00:30.000Z"},"UserAccount:16816927860069278135":{"__typename":"UserAccount","id":"16816927860069278135","totalWorkReviews":492,"name":"yoshi-maru","activityName":"@yoshi-maru","isOfficialUser":false},"TextualWorkReview:2912051607219998689":{"__typename":"TextualWorkReview","id":"2912051607219998689","reviewerUser":{"__ref":"UserAccount:16816927860069278135"},"title":"ゆっくりと積み上げる事も素晴らしい♪","body":"10歳にて自立せざるをえなかった境遇。\n\n…しかしながら、其れが後の主人公の糧となりストーリーが緩やかに展開していく。\n\n急ぎ過ぎず、また遅すぎないのが読んでいて面白い。\n\n登場人物、世界観、エピソードのボリューム等もバランスが良くて好み♪\n\n少しでも興味が出た方は是非一度読んで見て下さい(^o^)\n\n","textualCreatedAt":"2026-08-29T01:56:42Z","isSpoiler":false,"point":3,"likeCount":0,"visitorHasLiked":false},"UserAccount:2912051605713087855":{"__typename":"UserAccount","id":"2912051605713087855","totalWorkReviews":3,"name":"zawan_dev","activityName":"ざわん","isOfficialUser":false},"TextualWorkReview:2912051607247817360":{"__typename":"TextualWorkReview","id":"2912051607247817360","reviewerUser":{"__ref":"UserAccount:2912051605713087855"},"title":"毎日の掃除と洗濯が、いつか誰かの人生を変える","body":"儀式で授かったのは【経験値固定】——名前からして地味で、その場では誰にも注目されないスキル。この「地味さ」を作品全体の設計思想にまで貫き通したところに、本作の強さがあります。\n\n主人公エリクが王都でまず引き受けるのは、掃除、洗濯、食堂の下ごしらえ。ドラゴンでも迷宮でもありません。しかし彼が丁寧に切った野菜で食堂が繁盛し、丁寧に洗った洗濯物で宿の女将が笑い、丁寧に整理した倉庫にギルドの受付嬢が絶句する。積み上げた分だけ確実に「1」が入るスキルと、村で誰にも見てもらえないまま身につけた生活技能が、ここで完全に噛み合います。読んでいて気持ちがいいのは、彼の評価が「才能」ではなく「振る舞い」で上がっていくからです。\n\n家に居場所のなかった十歳の子が、宿でフカフカのベッドに驚き、人生初の風呂で三回髪を洗い、窓から月を見上げて「それだけでも凄い進歩だ」とつぶやく。この静かな一行のために全ての生活描写があるのだと思うと、序盤の淡々とした筆致がまるごと愛おしくなります。\n\n雛鳥亭のアマンダさん、氷の受付嬢レイナさん、鍛冶師ハロルドさん。彼らが差し出す「一枚多い肉」「貸出の装備」の温度がまた良い。刺激より滋養を求めている読者に、心から薦めたい一作です。","textualCreatedAt":"2026-08-28T08:05:22Z","isSpoiler":false,"point":3,"likeCount":1,"visitorHasLiked":false},"UserAccount:2912051607129404250":{"__typename":"UserAccount","id":"2912051607129404250","totalWorkReviews":1,"name":"kakukun","activityName":"@kakukun","isOfficialUser":false},"TextualWorkReview:2912051607129427958":{"__typename":"TextualWorkReview","id":"2912051607129427958","reviewerUser":{"__ref":"UserAccount:2912051607129404250"},"title":"なにもおこらない淡々と世界を冒険するだけ","body":"特化しないヒーラーと似たようなかんじかなこういう需要もあるんだね","textualCreatedAt":"2026-08-26T14:13:22Z","isSpoiler":false,"point":1,"likeCount":8,"visitorHasLiked":false},"UserAccount:16816700427380913798":{"__typename":"UserAccount","id":"16816700427380913798","totalWorkReviews":3,"name":"mrlittleking","activityName":"@mrlittleking","isOfficialUser":false},"TextualWorkReview:2912051607128720495":{"__typename":"TextualWorkReview","id":"2912051607128720495","reviewerUser":{"__ref":"UserAccount:16816700427380913798"},"title":"遅い","body":"なんでこんなに人気なのか謎ですが、今後に期待⋯⋯なんですかね\n個人的にはストーリーの進みが遅いし掃除が上手くなっているぐらいにしか成長も見られないけど、今後に期待するのも辛くなってきた⋯⋯\n\n清掃した回数が異常なのに誰も言及しないのも怖い😱ずっと掃除してるだけなのに\nまだレベル一桁だよ。何回掃除するの？","textualCreatedAt":"2026-08-26T14:00:36Z","isSpoiler":false,"point":1,"likeCount":13,"visitorHasLiked":false},"UserAccount:2912051607110434314":{"__typename":"UserAccount","id":"2912051607110434314","totalWorkReviews":1,"name":"Naco424","activityName":"@Naco424","isOfficialUser":false},"TextualWorkReview:2912051607110502482":{"__typename":"TextualWorkReview","id":"2912051607110502482","reviewerUser":{"__ref":"UserAccount:2912051607110434314"},"title":"圧倒的なチートに飽きた全ての人へ！努力と人柄で高みへ上っていく主人公！","body":"よくある、明らかに最強なチートを持っている主人公ではなく、まだ未発達なスキルを努力や人との縁で開花させていく主人公なので、入り込んで夢中で読めます！\n男主人公だと、いかにもなお色気やハーレムがあるかと警戒してしまいがちですが、純朴な少年が頑張り、成長する姿をほのぼのと見守る気持ちで読める最高の作品です！\n\n毎日この小説を楽しみに生きています！\nこちらの作品に初レビューしたいがために、カクヨムに登録しました。\n\nこれからも応援し続けます！","textualCreatedAt":"2026-08-26T09:35:51Z","isSpoiler":false,"point":3,"likeCount":2,"visitorHasLiked":false},"UserAccount:16816452219227634484":{"__typename":"UserAccount","id":"16816452219227634484","totalWorkReviews":133,"name":"am3160","activityName":"五月雨前線","isOfficialUser":false},"TextualWorkReview:2912051606911459444":{"__typename":"TextualWorkReview","id":"2912051606911459444","reviewerUser":{"__ref":"UserAccount:16816452219227634484"},"title":"書き方が参考になる","body":"","textualCreatedAt":"2026-08-23T14:47:18Z","isSpoiler":false,"point":3,"likeCount":1,"visitorHasLiked":false},"UserAccount:1177354054884406286":{"__typename":"UserAccount","id":"1177354054884406286","totalWorkReviews":1,"name":"nekoyamainutarou","activityName":"@nekoyamainutarou","isOfficialUser":false},"TextualWorkReview:2912051606885592689":{"__typename":"TextualWorkReview","id":"2912051606885592689","reviewerUser":{"__ref":"UserAccount:1177354054884406286"},"title":"こういうのでいいんだよ","body":"シンプルなファンタジーで読みやすい。\n今後も読みたい作品","textualCreatedAt":"2026-08-23T08:36:24Z","isSpoiler":false,"point":3,"likeCount":4,"visitorHasLiked":false},"UserAccount:2912051602144863589":{"__typename":"UserAccount","id":"2912051602144863589","totalWorkReviews":28,"name":"tsubuan3","activityName":"@tsubuan3","isOfficialUser":false},"TextualWorkReview:2912051606861066433":{"__typename":"TextualWorkReview","id":"2912051606861066433","reviewerUser":{"__ref":"UserAccount:2912051602144863589"},"title":"コツコツと","body":"成長していく姿を丁寧に描写されています。\n無駄に長い解説調もなく楽しく読めました。\nこれからも良い方たちとの触れ合いを楽しみにしてます。","textualCreatedAt":"2026-08-23T02:13:18Z","isSpoiler":false,"point":3,"likeCount":6,"visitorHasLiked":false},"UserAccount:16817330654485537514":{"__typename":"UserAccount","id":"16817330654485537514","totalWorkReviews":292,"name":"nobu0522","activityName":"@nobu0522","isOfficialUser":false},"TextualWorkReview:2912051606827036741":{"__typename":"TextualWorkReview","id":"2912051606827036741","reviewerUser":{"__ref":"UserAccount:16817330654485537514"},"title":"地道に努力する主人公の少年が、引き受けた仕事を直向きにするのが好ましい","body":"仕事を依頼した人達は仕事の仕上がりと手早く丁寧な様子に心を打たれる。その交流も微笑ましい。彼のスキルの成長の先に待っている景色が楽しみでしかたない。ワクワクしながら待っている。","textualCreatedAt":"2026-08-22T13:13:00Z","isSpoiler":false,"point":3,"likeCount":5,"visitorHasLiked":false},"UserAccount:2912051605845817339":{"__typename":"UserAccount","id":"2912051605845817339","totalWorkReviews":11,"name":"amamiya-ruika","activityName":"天宮涙花","isOfficialUser":false},"TextualWorkReview:2912051606817724439":{"__typename":"TextualWorkReview","id":"2912051606817724439","reviewerUser":{"__ref":"UserAccount:2912051605845817339"},"title":"剣を抜く前から、もう冒険は始まっている。","body":"「10歳の少年が冒険者になる」という王道の入口から始まりながら、本作が描くのは、大きな成功だけではありません。\n\n自分にできることを一つずつ積み重ね、働き、学び、人と関わりながら、自分の人生を自分の手で作っていく。その過程に、とても穏やかで確かな魅力があります。\n\n主人公エリクが素敵なのは、必要以上に自分を悲劇の主人公にせず、力を誇示することもなく、目の前のことへ誠実に向き合っていくところ。冷静で堅実。それでいて、人への優しさを失わない。その人柄そのものを、いつの間にか応援したくなります。\n\n冒険と成長、そして日々の暮らしが地続きに描かれているからこそ、一歩前へ進むことがこんなにも嬉しい。\n\n読み進めるほどに、\n「この少年の明日を、もう少し見ていたい」\nと思わせてくれる作品です。\n\n華やかだけではない、本当の意味での【強さ】を感じられる、優しく心地よい冒険譚でした。私も励まされます。","textualCreatedAt":"2026-08-22T10:49:58Z","isSpoiler":false,"point":3,"likeCount":4,"visitorHasLiked":false},"WorkTopWorkReviews:2912051605905477135":{"__typename":"WorkTopWorkReviews","id":"2912051605905477135","newTextualWorkReviews":[{"__ref":"TextualWorkReview:2912051607219998689"},{"__ref":"TextualWorkReview:2912051607247817360"},{"__ref":"TextualWorkReview:2912051607129427958"},{"__ref":"TextualWorkReview:2912051607128720495"},{"__ref":"TextualWorkReview:2912051607110502482"},{"__ref":"TextualWorkReview:2912051606911459444"},{"__ref":"TextualWorkReview:2912051606885592689"},{"__ref":"TextualWorkReview:2912051606861066433"},{"__ref":"TextualWorkReview:2912051606827036741"},{"__ref":"TextualWorkReview:2912051606817724439"}]},"UserAccount:1177354055637079323":{"__typename":"UserAccount","id":"1177354055637079323","name":"gainoze","activityName":"@gainoze","isOfficialUser":false},"Work:2912051604891101737":{"__typename":"Work","id":"2912051604891101737","catchphrase":"門を閉じた日、王国の終わりが始まる。","baseColor":"#FF5D81","author":{"__ref":"UserAccount:1177354055637079323"},"title":"婚約破棄されたので辺境都市の門を閉じました","alternateTitle":null,"isFreshWork":false,"hasFreshEpisode":false,"publishedAt":"2026-07-26T12:38:23Z","lastEpisodePublishedAt":"2026-08-26T01:00:09Z","alternateAuthorName":null,"totalReviewPoint":4428,"fanFictionSource":nul