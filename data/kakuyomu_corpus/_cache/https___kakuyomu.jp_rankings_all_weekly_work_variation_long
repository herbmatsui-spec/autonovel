UserAccount","id":"16818792440596107910","name":"kanata0802","activityName":"@kanata0802","isOfficialUser":false},"TextualWorkReview:2912051605488679759":{"__typename":"TextualWorkReview","id":"2912051605488679759","work":{"__ref":"Work:16818093091438419891"},"title":"続きが！続きがとても気になります！","reviewer":{"__ref":"UserAccount:16818792440596107910"}},"UserAccount:822139845299189916":{"__typename":"UserAccount","id":"822139845299189916","name":"pedripotter","activityName":"@pedripotter","isOfficialUser":false},"TextualWorkReview:2912051604566383311":{"__typename":"TextualWorkReview","id":"2912051604566383311","work":{"__ref":"Work:16818093091438419891"},"title":"めちゃくちゃ面白い","reviewer":{"__ref":"UserAccount:822139845299189916"}},"UserAccount:1177354054890341668":{"__typename":"UserAccount","id":"1177354054890341668","name":"feyfon","activityName":"あちゅ和尚","isOfficialUser":false},"Work:2912051605781475130":{"__typename":"Work","id":"2912051605781475130","baseColor":"#371F6A","catchphrase":"黒パン半分の恩返しから、幼竜と寒村は国になる。","introduction":"現代日本で死んだ俺が目を覚ますと、異世界のドラゴンになっていた。\n\nただし、空を自在に飛ぶ古竜でも、軍隊を焼き払う竜王でもない。\n\n翼はあっても飛べない。\nブレスは弱い。\n人間の罠にかかり、狼の魔物に囲まれれば死にかねない――ただの幼竜だった。\n\n山奥で飢えかけていた俺に食べ物をくれたのは、貧しい村に暮らす少女リナ。\n\n彼女自身も腹を空かせているのに、固い黒パンを半分に割り、大きい方を俺へ差し出した。\n\nだから、借りを返すことにした。\n\n畑を荒らす魔物を倒し、盗賊を追い払い、村を守る。\n\nそれだけのつもりだった。\n\nだが、安全になった村には人が集まり、商人が訪れ、職人が住み着き、やがて人間だけでなく亜人や知性ある魔物まで集まり始める。\n\n寒村は交易村へ。\n交易村は町へ。\n町は城塞都市へ。\n\nそして俺自身も、守るものが増えるほど進化していく。\n\n幼竜から若竜へ。\n成竜、古竜、そして竜王へ。\n\nこれは世界を支配したかったドラゴンの物語ではない。\n\n黒パン半分の借りを返し続けた一匹の幼竜と、滅びかけていた小さな村が、やがて世界を揺るがす国へ成長していく物語。","author":{"__ref":"UserAccount:1177354054890341668"},"title":"『ドラゴンに転生したので、人間の国を育てることにした 〜黒パン半分の恩返しから始まる竜王建国記〜』","alternateTitle":null,"isFreshWork":false,"hasFreshEpisode":true,"publishedAt":"2026-08-08T08:40:56Z","lastEpisodePublishedAt":"2026-08-29T04:30:15Z","alternateAuthorName":null,"totalReviewPoint":1641,"fanFictionSource":null,"genre":"FANTASY","serialStatus":"RUNNING","publicEpisodeCount":98,"totalCharacterCount":448908,"hasPublication":