:17:49Z","alternateAuthorName":null,"totalReviewPoint":2662,"fanFictionSource":null,"genre":"ACTION","serialStatus":"RUNNING","publicEpisodeCount":22,"totalCharacterCount":76064,"hasPublication":false,"publicationEntryPath":null,"isCruel":false,"isViolent":false,"isSexual":false,"tagLabels":["現代ダンジョン","配信","師匠","おっさん主人公","無自覚","曇らせ","成り上がり","ノンストレス"],"textualWorkReviewsForCatchphraseInRandom":[{"__ref":"TextualWorkReview:2912051607212157916"},{"__ref":"TextualWorkReview:2912051607257412148"}]},"UserAccount:16817330656291030906":{"__typename":"UserAccount","id":"16817330656291030906","name":"jisitsu-keeper","activityName":"羽黒楓","isOfficialUser":false},"TextualWorkReview:2912051607212157916":{"__typename":"TextualWorkReview","id":"2912051607212157916","work":{"__ref":"Work:2912051604434822405"},"title":"素晴らしい","reviewer":{"__ref":"UserAccount:16817330656291030906"}},"UserAccount:1177354054881961386":{"__typename":"UserAccount","id":"1177354054881961386","name":"hiiro001","activityName":"めいびぃ","isOfficialUser":false},"TextualWorkReview:2912051607257412148":{"__typename":"TextualWorkReview","id":"2912051607257412148","work":{"__ref":"Work:2912051604434822405"},"title":"たまに泣きそうになる","reviewer":{"__ref":"UserAccount:1177354054881961386"}},"UserAccount:1177354054895187787":{"__typename":"UserAccount","id":"1177354054895187787","name":"motonobu","activityName":"秋津　モトノブ","isOfficialUser":false},"Work:2912051605955633703":{"__typename":"Work","id":"2912051605955633703","baseColor":"#000000","catchphrase":"原作知識で無双したいのに、原作が始まる前に死ぬかもしれん。","introduction":"【完結まで毎日12時投稿！】\n\n　ロイド＝ベルクは『鎧騎兵(ガイキヘイ)』と呼ばれるヒト型ロボットのパイロット、『騎手』候補生であり……転生者である。\n彼は、前世で大いにハマり込んだ名作ファンタジー小説『帝歴1002　鎧騎兵、走る』シリーズそのものか、非常に酷似した異世界へ転生してしまった。\n\n　『大好きな作品世界に来れた！』と、5歳の時に前世の記憶を思い出した当初は狂喜乱舞した彼であったが……年号を確認した瞬間、絶望の淵に叩き落とされてしまう。\n彼が騎手になって初めて赴くであろう赴任先……『西方辺境領』は、原作1巻の『プロローグ』で滅んでしまう場所だということを知ったからだ。\n\n　ならば騎手にならなければいいかと言えば、それも無理。\n彼の亡き父は騎士爵を持つ騎手であり、残された家族の生活の為に、ベルク家長男であるロイドはソレを継ぐ必要がある。\n通常は継承できない一代限りの騎士爵だが、騎手になれば特例で継承できるのだ。\nそして……『騎士爵持ちの騎手』が配置されるのは、決まって『西方辺境領』なのだ。\n\n「ちくしょう……神様の馬鹿野郎……！」\n\n　家族の為に逃げることもできないロイドは、原作にもほとんど描写のない地獄の『プロローグ』を生き残るために、今日も騎手訓練校で訓練に励んでいる。\n\n「原作知識は唸るほどあるのに！　原作が始まる前に死にたくねぇよ～！！」\n\n　これは、転生者ロイド＝ベルクが原作にたどり着くために死に物狂いで生きる物語である。\n……死に物狂いで生き過ぎた結果、原作を大いに破壊しまくる物語でもある。","author":{"__ref":"UserAccount:1177354054895187787"},"title":"鎧騎兵、走る～大好きなロボット作品っぽい世界に転生したけど、プロローグで滅ぶ場所にいます。生き残りたい！　すごく生き残りたい！！～","alternateTitle":null,"isFreshWork":false,"hasFreshEpisode":false,"publishedAt":"2026-08-11T03:00:48Z","lastEpisodePublishedAt":"2026-08-29T03:00:03Z","alternateAuthorName":null,"totalReviewPoint":3668,"fanFictionSource":null,"genre":"FANTASY","serialStatus":"RUNNING","publicEpisodeCount":19,"totalCharacterCount":99503,"hasPublication":false,"publicationEntryPath":null,"isCruel":true,"isViolent":true,"isSexual":true,"tagLabels":["異世界転生","ロボット","成りあがり","一人称","エルフ","男性主人公","知識チート"],"textualWorkReviewsForCatchphraseInRandom":[{"__ref":"TextualWorkReview:2912051607043230277"},{"__ref":"TextualWorkReview:2912051607128787099"}]},"UserAccount:2912051603970784481":{"__typename":"UserAccount","id":"2912051603970784481","name":"prya","activityName":"@prya","isOfficialUser":false},"TextualWorkReview:2912051607043230277":{"__typename":"TextualWorkReview","id":"2912051607043230277","work":{"__ref":"Work:2912051605955633703"},"title":"面白くて一気読み！最新話に追いついちゃった！いいトコなのにっ","reviewer":{"__ref":"UserAccount:2912051603970784481"}},"UserAccount:2912051602144863589":{"__typename":"UserAccount","id":"2912051602144863589","name":"tsubuan3","activityName":"@tsubuan3","isOfficialUser":false},"TextualWorkReview:2912051607128787099":{"__typename":"TextualWorkReview","id":"2912051607128787099","work":{"__ref":"Work:2912051605955633703"},"title":"素晴らしき胸部装甲エルフ","reviewer":{"__ref":"UserAccount:2912051602144863589"}},"UserAccount:2912051605696313815":{"__typename":"UserAccount","id":"2912051605696313815","name":"masakamo","activityName":"宵白レン","isOfficialUser":false},"Work:2912051605717497440":{"__typename":"Work","id":"2912051605717497440","baseColor":"#0033C4","catchphrase":"世界が凍った日、俺はすべてを捨てた。人への信頼以外を全部拾い直すために","introduction":"世界を襲った、予測不能の異常寒波。\n物流は止まり、食料は尽き、電気も水道も失われていく。\n文明の崩壊とともに、人々が当たり前だと思っていた秩序も崩れ始めた。\n極限状態の中、人はどこまで人としての倫理を失い、残酷になれるのか。\nそして、法律も秩序も失われた世界で、人々はどんな新たな社会を作るのか。\n\nそんな世界で一度命を落とした神崎蓮は、なぜか寒波が訪れる一ヶ月前へ転生する。\n手にしたのは、あらゆる物資を保存できる謎の能力。\n\n前の人生で人に裏切られ、雪の中で死を迎えた蓮は、すべての甘さを捨てた。\n善意ではなく対価を。情ではなく合理を。\n\nこれは極寒の世界を舞台に、人間の本質を描く終末サバイバル。","author":{"__ref":"UserAccount:2912051605696313815"},"title":"氷河期ストレージ  ～裏切られて死んだ俺は、30日前に戻り無限収納で世界を生き抜く～","alternateTitle":null,"isFreshWork":false,"hasFreshEpisode":false,"publishedAt":"2026-08-07T10:22:50Z","lastEpisodePublishedAt":"2026-08-28T23:10:43Z","alternateAuthorName":null,"totalReviewPoint":3033,"fanFictionSource":null,"genre":"ACTION","serialStatus":"RUNNING","publicEpisodeCount":93,"totalCharacterCount":527150,"hasPublication":false,"publicationEntryPath":null,"isCruel":true,"isViolent":true,"isSexual":false,"tagLabels":["現代ファンタジー","終末","秩序崩壊","人間ドラマ","ざまぁ","タイムリープ","群像劇","AI本文一部利用"],"textualWorkReviewsForCatchphraseInRandom":[{"__ref":"TextualWorkReview:2912051607260079891"},{"__ref":"TextualWorkReview:2912051607169121331"}]},"UserAccount:2912051595251663887":{"__typename":"UserAccount","id":"2912051595251663887","name":"mesomeso9","activityName":"いたかや","isOfficialUser":false},"TextualWorkReview:2912051607260079891":{"__typename":"TextualWorkReview","id":"2912051607260079891","work":{"__ref":"Work:2912051605717497440"},"title":"珍しい、一貫性のある情に流されない人物が主人公の作品","reviewer":{"__ref":"UserAccount:2912051595251663887"}},"UserAccount:822139844387716614":{"__typename":"UserAccount","id":"822139844387716614","name":"mashido","activityName":"@mashido","isOfficialUser":false},"TextualWorkReview:2912051607169121331":{"__typename":"TextualWorkReview","id":"2912051607169121331","work":{"__ref":"Work:2912051605717497440"},"title":"時間を忘れさせる面白さ…故に肩が凝る","reviewer":{"__ref":"UserAccount:822139844387716614"}},"UserAccount:16816927861155483847":{"__typename":"Use